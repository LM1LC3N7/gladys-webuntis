          "type": "string",
          "label": { "en": "First lesson: start", "fr": "Premier cours : début" }
        },
        {
          "key": "first_subject",
          "type": "string",
          "label": { "en": "First lesson: subject", "fr": "Premier cours : matière" }
        },
        {
          "key": "first_room",
          "type": "string",
          "label": { "en": "First lesson: room", "fr": "Premier cours : salle" }
        },
        {
          "key": "last_end",
          "type": "string",
          "label": { "en": "End of the day", "fr": "Fin de la journée" }
        },
        {
          "key": "lesson_count",
          "type": "number",
          "label": { "en": "Lessons held", "fr": "Cours maintenus" }
        },
        {
          "key": "cancelled_count",
          "type": "number",
          "label": { "en": "Lessons cancelled", "fr": "Cours annulés" }
        },
        {
          "key": "changed_count",
          "type": "number",
          "label": { "en": "Lessons changed", "fr": "Cours modifiés" }
        },
        { "key": "exam_count", "type": "number", "label": { "en": "Exams", "fr": "Examens" } },
        {
          "key": "late_start",
          "type": "boolean",
          "label": { "en": "Starts later than planned", "fr": "Commence plus tard que prévu" }
        },
        {
          "key": "minutes_before",
          "type": "number",
          "label": {
            "en": "Minutes before the first lesson",
            "fr": "Minutes avant le premier cours"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_school_day",
      "label": {
        "en": "Read a school day (WebUntis)",
        "fr": "Lire une journée d'école (WebUntis)"
      },
      "description": {
        "en": "The lessons of a day from the last reading (no new request), for a message or a condition that follows.",
        "fr": "Les cours d'une journée d'après la dernière lecture (sans nouvelle requête), pour un message ou une condition qui suit."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "day",
          "type": "select",
          "required": false,
          "default": "today",
          "label": { "en": "Day", "fr": "Jour" },
          "options": [
            {
              "value": "auto",
              "label": {
                "en": "Today, then the next school day",
                "fr": "Aujourd'hui, puis le prochain jour d'école"
              }
            },
            { "value": "today", "label": { "en": "Today", "fr": "Aujourd'hui" } },
            { "value": "tomorrow", "label": { "en": "Tomorrow", "fr": "Demain" } },
            {
              "value": "next_school_day",
              "label": { "en": "Next school day", "fr": "Prochain jour d'école" }
            }
          ]
        }
      ],
      "outputs": [
        { "key": "date", "type": "string", "label": { "en": "Date", "fr": "Date" } },
        {
          "key": "weekday",
          "type": "string",
          "label": { "en": "Weekday (mon to sun)", "fr": "Jour (mon à sun)" }
        },
        {
          "key": "has_school",
          "type": "boolean",
          "label": { "en": "Lessons held", "fr": "Cours maintenus" }
        },
        {
          "key": "lesson_count",
          "type": "number",
          "label": { "en": "Number of lessons held", "fr": "Nombre de cours maintenus" }
        },
        {
          "key": "cancelled_count",
          "type": "number",
          "label": { "en": "Lessons cancelled", "fr": "Cours annulés" }
        },
        {
          "key": "changed_count",
          "type": "number",
          "label": { "en": "Lessons changed", "fr": "Cours modifiés" }
        },
        { "key": "exam_count", "type": "number", "label": { "en": "Exams", "fr": "Examens" } },
        {
          "key": "first_start",
          "type": "string",
          "label": { "en": "First lesson: start", "fr": "Premier cours : début" }
        },
        {
          "key": "first_subject",
          "type": "string",
          "label": { "en": "First lesson: subject", "fr": "Premier cours : matière" }
        },
        {
          "key": "last_end",
          "type": "string",
          "label": { "en": "End of the day", "fr": "Fin de la journée" }
        },
        {
          "key": "late_start",
          "type": "boolean",
          "label": { "en": "Starts later than planned", "fr": "Commence plus tard que prévu" }
        },
        {
          "key": "list",
          "type": "string",
          "label": { "en": "Lessons, one per line", "fr": "Cours, un par ligne" }
        },
        {
          "key": "read_at",
          "type": "string",
          "label": { "en": "Time of the reading", "fr": "Heure de la lecture" }
        }
      ]
    }
  ]
}
